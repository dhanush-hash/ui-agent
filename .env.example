# Language Translation Service API
# Copy to `.env.local` and fill in. Never commit real values.

# Base URL of the API (from the OpenAPI `servers` block).
# Local dev: http://localhost:8080 — Production: https://api.fynxt.com
VITE_API_BASE_URL=http://localhost:8080

# Multi-tenancy + authorization context required by GET /assets.
VITE_API_TENANT_ID=
VITE_API_USER_ID=
VITE_API_USER_ROLES=
